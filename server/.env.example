PORT=5000
NODE_ENV=development

# MongoDB connection string. Production: your MongoDB Atlas URI.
# Development: `npm run dev` (repo root) starts a local database at
#   mongodb://127.0.0.1:27027/swipehire  (data kept in server/.data)
# Leave empty to make the API start its own temporary local database instead.
MONGO_URI=mongodb://127.0.0.1:27027/swipehire

# Random string, at least 32 characters. REQUIRED (server will not start without it).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Login cookie: lax if site and API share a domain (e.g. swipehire.in + api.swipehire.in), none if on different domains
COOKIE_SAMESITE=lax

# Free swipes every new company gets
FREE_SWIPES=5

# Razorpay keys (https://dashboard.razorpay.com/app/keys).
# Leave empty in development to use demo payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret (Dashboard -> Webhooks). Webhook URL: https://<api-domain>/api/payment/webhook
# Events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=

# Simulated purchases (one click, no money) for testing. Ignored when Razorpay keys are set.
# On the live site it also needs DEMO_PAYMENTS_ON_LIVE=true. Remove both before launch.
DEMO_PAYMENTS=true

# TESTING ONLY: also show the sign-up email code on screen (e.g. before you have a domain,
# when the email service can only reach your own inbox). Anyone could then verify any email,
# so remove it before launch.
# SHOW_EMAIL_CODE=true

# Comma separated emails that can open /admin (approve company GST verification)
ADMIN_EMAILS=

# Email sending (Brevo / Resend / Zoho / Gmail SMTP). Empty = emails are printed in the server console
# and the sign-up verification code is shown on screen (local testing only).
# Brevo (works without your own domain; sends to anyone from a verified sender, 300/day free):
#          BREVO_API_KEY=<xkeysib-... key>   MAIL_FROM=Swipe Hire <your-verified-sender@gmail.com>
# Resend:  SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  SMTP_PASS=<your re_... API key>
#          MAIL_FROM must use a domain you verified in Resend (Domains), e.g. Swipe Hire <no-reply@swipehire.in>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Swipe Hire <no-reply@swipehire.in>
